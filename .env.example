# ============================================================
# Stock Market Analysis Bot — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.
# ============================================================

# --- Discord ---
# Create a webhook in your server: Channel Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
# Optional: separate webhook for high-priority alerts (e.g. a different channel)
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ALERT_WEBHOOK_ID/YOUR_ALERT_WEBHOOK_TOKEN

# --- News API (free tier = 100 req/day) ---
# Register at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# --- Finnhub (free tier = 60 req/min) ---
# Register at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# --- Twitter / X API v2 (free = 500k tweet reads/month) ---
# Create a project & app at https://developer.x.com/en/portal/dashboard
# The bot only needs READ access — use the "Bearer Token" from your app
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# --- Alpha Vantage (optional, supplemental data) ---
# Free at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
